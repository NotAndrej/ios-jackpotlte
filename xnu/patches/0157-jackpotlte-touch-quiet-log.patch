 #include <pexpert/pexpert.h>
 #include <pexpert/arm64/board_config.h>
 
+/*
+ * Every touch log line goes through jt_log(), which is silent unless
+ * a8touchverbose=1.  A printf() per event to the framebuffer console is
+ * itself load on the path a swipe depends on (0150), and the lines are
+ * noise on a boot that is being watched; the switch turns the whole set
+ * back on when a bring-up needs them.
+ */
+static bool
+jt_touch_log(void)
+{
+	static int parsed = 0;
+	static bool on = false;
+	int value = 0;
+
+	if (!parsed) {
+		(void)PE_parse_boot_argn("a8touchverbose", &value, sizeof(value));
+		on = (value != 0);
+		parsed = 1;
+	}
+	return on;
+}
+
+#define jt_log(...)	do { if (jt_touch_log()) { printf(__VA_ARGS__); } } while (0)
+
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
