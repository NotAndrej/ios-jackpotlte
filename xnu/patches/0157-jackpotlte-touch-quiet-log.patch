+/*
+ * Touch logging is off unless a8touchverbose=1 -- the same switch the
+ * A5XELTE touch driver uses (bsd/dev/a5xelte_touch.c).  One line per
+ * contact is noise on the framebuffer console, and printing on the path a
+ * swipe depends on is itself load on it.
+ */
+static bool
+sweet_hid_touch_log(void)
+{
+	static int parsed = 0;
+	static bool on = false;
+	int value = 0;
+
+	if (!parsed) {
+		(void)PE_parse_boot_argn("a8touchverbose", &value, sizeof(value));
+		on = (value != 0);
+		parsed = 1;
+	}
+	return on;
+}
