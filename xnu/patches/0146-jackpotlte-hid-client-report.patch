 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
 
+/*
+ * Diagnostic (boot-arg sweethidtest=N): how many user clients have opened
+ * each Sweet HID service.  With the quiet console the screen keeps
+ * drawing until the GUI's first present and only then goes silent, so the
+ * last visible line of this report is the state at the moment backboardd
+ * started presenting -- i.e. whether it had opened the digitizer/buttons.
+ */
+static void
+sweet_hid_report_clients(void)
+{
+	IOLog("SWEET HID: clients buttons=%u touch=%u\n",
+	    gSweetButtons ? gSweetButtons->clientCount() : 0u,
+	    gSweetTouch ? gSweetTouch->clientCount() : 0u);
+}
