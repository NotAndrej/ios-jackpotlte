+		 * the same reason (`GPU_ID2_PRODUCT_MODEL`,
+		 * `mali_kbase_gpu_id.h:50`, compared at
+		 * `mali_kbase_core_linux.c:2856`). */
+		*value = (jt_gpu_id >> 16) & 0xf00fu;
 		return true;
