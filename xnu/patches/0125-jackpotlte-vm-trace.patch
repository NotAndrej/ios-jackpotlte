diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
index de4a6a7..9de22b5 100644
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1285,10 +1285,19 @@ pmap_steal_memory_internal(
 	if (size >= I386_LPGBYTES) {
 		virtual_space_start = ((virtual_space_start + I386_LPGMASK) & ~I386_LPGMASK);
 	}
+#endif
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	kprintf("A5 steal: size=%#llx align=%#lx might_free=%d vs=%#llx..%#llx\n",
+	    (unsigned long long)size, (unsigned long)alignment, (int)might_free,
+	    (unsigned long long)virtual_space_start, (unsigned long long)virtual_space_end);
 #endif
 	virtual_space_start = (virtual_space_start + (alignment - 1)) & ~(alignment - 1);
 	addr = virtual_space_start;
 	virtual_space_start += size;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	kprintf("A5 steal: addr=%#llx new_vs=%#llx\n",
+	    (unsigned long long)addr, (unsigned long long)virtual_space_start);
+#endif
 
 	//kprintf("pmap_steal_memory: %08lX - %08lX; size=%08lX\n", (long)addr, (long)virtual_space_start, (long)size);	/* (TEST/DEBUG) */
 
@@ -1324,6 +1333,13 @@ pmap_steal_memory_internal(
 		if (!pmap_next_page_hi(&phys_page, might_free)) {
 			panic("pmap_steal_memory() size: 0x%llx", (uint64_t)size);
 		}
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+		/* One line per 1024 mapped pages (4 MiB of VA). */
+		if ((((vm_offset_t)map_addr >> 12) & 0x3ff) == 0) {
+			kprintf("A5 steal: map=%#lx phys=%#x\n",
+			    (unsigned long)map_addr, (unsigned)phys_page);
+		}
+#endif
 
 #if defined(__x86_64__)
 		pmap_pre_expand(kernel_pmap, map_addr);
@@ -1419,6 +1435,11 @@ pmap_startup(
 		virtual_space_start = round_page(virtual_space_start);
 	}
 #endif
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* Jackpotlte bring-up: where the early boot VA grab hands over. */
+	kprintf("A5 vm: enter vs=%#llx ve=%#llx\n",
+	    (unsigned long long)virtual_space_start, (unsigned long long)virtual_space_end);
+#endif
 
 	/*
 	 * We calculate how many page frames we will have
@@ -1439,7 +1460,11 @@ pmap_startup(
 #endif /* defined(__arm64__) */
 	mem_sz += round_page(virtual_space_start) - virtual_space_start;        /* Account for any slop */
 	npages = (uint_t)(mem_sz / (PAGE_SIZE + sizeof(*vm_pages)));    /* scaled to include the vm_page_ts */
-
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	/* The next A5 marker is *after* pmap_steal_freeable_memory() returns. */
+	kprintf("A5 vm: span=%u mem_sz=%#llx npages=%u\n",
+	    pmap_free_pages_span(), (unsigned long long)mem_sz, npages);
+#endif
 
 	vm_pages = (vm_page_t) pmap_steal_freeable_memory(npages * sizeof *vm_pages);
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
