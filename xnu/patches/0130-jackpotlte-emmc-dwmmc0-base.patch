diff --git a/bsd/dev/a5xelte_emmc.c b/bsd/dev/a5xelte_emmc.c
--- a/bsd/dev/a5xelte_emmc.c
+++ b/bsd/dev/a5xelte_emmc.c
@@ -441,12 +441,20 @@
 	DTEntry node;
 	uintptr_t const *reg = NULL;
 	unsigned int size = 0;
+#if defined(JACKPOTLTE)
+	/* Galaxy A8 2018 (Exynos 7885): the eMMC is dwmmc0 at 0x13500000
+	 * (Samsung exynos7885.dtsi; dwmmc1 0x13510000 is SDIO and dwmmc2
+	 * 0x13550000 is the SD card). The A5 (Exynos7580) uses 0x13540000. */
+	uintptr_t const expected_base = 0x13500000u;
+#else
+	uintptr_t const expected_base = 0x13540000u;
+#endif
 	if (emmc_regs) {
 		return 0;
 	}
 	if (SecureDTLookupEntry(NULL, "/a5xelte-emmc", &node) != kSuccess ||
 	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
-	    size < 2 * sizeof(uintptr_t) || reg[0] != 0x13540000u || reg[1] < 0x2000u) {
+	    size < 2 * sizeof(uintptr_t) || reg[0] != expected_base || reg[1] < 0x2000u) {
 		printf("A5XELTE eMMC: missing or unexpected ADT register window\n");
 		return ENXIO;
 	}
