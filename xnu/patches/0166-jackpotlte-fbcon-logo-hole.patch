+/*
+ * The shim may have drawn the Apple boot logo (boot-arg jtlogo=1) into the
+ * panel memory at A5_LOGO_X/Y/W/H.  fbcon_init() clears the whole panel and
+ * the console draws over it, which would erase the logo the moment the kernel
+ * takes the screen.  Nothing is cleared or drawn inside that rectangle
+ * instead, so the shim's pixels stay; jtlogo is what the shim drew behind, so
+ * the two are always set together.  With fbcon_hole 0 this is a no-op.
+ */
+static uint32_t fbcon_hole_x0, fbcon_hole_y0, fbcon_hole_x1, fbcon_hole_y1;
+static int fbcon_hole;
+
+static inline int
+fbcon_in_hole(uint32_t x, uint32_t y)
+{
+	return fbcon_hole && x >= fbcon_hole_x0 && x < fbcon_hole_x1 &&
+	    y >= fbcon_hole_y0 && y < fbcon_hole_y1;
+}
+
