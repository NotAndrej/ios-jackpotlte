+/* sec_ts multi-byte command write: START, slave write address, N bytes, STOP.
+ * Mirrors sec_ts_i2c_write(ts, cmd, data, len) (sec_ts.c:489) and the S8's
+ * s8i2c_xfer(addr, func, 3, NULL, 0) for SET_TOUCHFUNCTION (0124). */
+static bool
+jtts_write_bytes(const uint8_t *bytes, unsigned count)
+{
+	bool ok = false;
+	int recovered = 0;
+	if (!count) {
+		return false;
+	}
+retry:
+	for (unsigned n = 0; n < 2000; n++) {
+		if (!(a5touch_read(jt_ts_bus, JTTS_IICSTAT) & JTTS_IICSTAT_START)) {
+			break;
+		}
+		if (n == 1999) {
+			if (recovered++) {
+				printf("A8 TOUCH: i2c4 still busy on write\n");
+				return false;
+			}
+			jtts_bus_recover();
+			goto retry;
+		}
+		delay(1);
+	}
+	if (!jtts_address(JTTS_IICSTAT_MASTER_TX, JT_TS_SLAVE << 1)) {
+		goto out;
+	}
+	if (!jtts_tx(bytes, count)) {
+		goto out;
+	}
+	ok = true;
+out:
+	jtts_stop();
+	return ok;
+}
+
+/* sec_ts register read with the native driver's retry: a read that NACKs
+ * while the IC is scanning (seen on the phone as stat=0x30 with SDA held low)
+ * is retried instead of dropped, so finger movement is not lost. */
+static bool
+jtts_read_retry(uint8_t reg, uint8_t *data, unsigned count)
+{
+	for (unsigned attempt = 0; attempt < JTTS_READ_ATTEMPTS; attempt++) {
+		if (attempt) {
+			jt_ts_retries++;
+			delay(JTTS_READ_RETRY_US);
+		}
+		if (jtts_read_reg(reg, data, count)) {
+			return true;
+		}
+	}
+	jt_ts_lost++;
+	return false;
+}
