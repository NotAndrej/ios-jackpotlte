diff --git a/osfmk/vm/vm_resident.c b/osfmk/vm/vm_resident.c
--- a/osfmk/vm/vm_resident.c
+++ b/osfmk/vm/vm_resident.c
@@ -1334,11 +1334,10 @@
 			panic("pmap_steal_memory() size: 0x%llx", (uint64_t)size);
 		}
 #if defined(ARM64_BOARD_CONFIG_A5XELTE)
-		/* One line per 1024 mapped pages (4 MiB of VA). */
-		if ((((vm_offset_t)map_addr >> 12) & 0x3ff) == 0) {
-			kprintf("A5 steal: map=%#lx phys=%#x\n",
-			    (unsigned long)map_addr, (unsigned)phys_page);
-		}
+		/* One line per page: the last line before the console stops is the
+		 * page whose pmap_enter() never returned. */
+		kprintf("A5 pg: va=%#lx pa=%#x\n",
+		    (unsigned long)map_addr, (unsigned)phys_page);
 #endif
 
 #if defined(__x86_64__)
@@ -1348,6 +1347,9 @@
 		kr = pmap_enter(kernel_pmap, map_addr, phys_page,
 		    VM_PROT_READ | VM_PROT_WRITE, VM_PROT_NONE,
 		    VM_WIMG_USE_DEFAULT, FALSE);
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+		kprintf("A5 pg: ok va=%#lx kr=%d\n", (unsigned long)map_addr, (int)kr);
+#endif
 
 		if (kr != KERN_SUCCESS) {
 			panic("pmap_steal_memory() pmap_enter failed, map_addr=%#lx, phys_page=%u",
@@ -1362,6 +1364,11 @@
 		vm_page_stolen_count++;
 	}
 
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	kprintf("A5 steal: done addr=%#llx end=%#llx\n",
+	    (unsigned long long)addr, (unsigned long long)(addr + size));
+#endif
+
 #if defined(__x86_64__)
 	/*
 	 * The call with might_free is currently the last use of pmap_steal_memory*().
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2301,6 +2301,12 @@
 #endif
 #endif
 	sweet_early_mark(12, "calling pmap_bootstrap");
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	kprintf("A5 avm: pbase=%#llx slide=%#llx sme=%#llx dmb=%#llx msz=%#llx\n",
+	    (unsigned long long)physmap_base, (unsigned long long)physmap_slide,
+	    (unsigned long long)static_memory_end, (unsigned long long)dynamic_memory_begin,
+	    (unsigned long long)mem_size);
+#endif
 	pmap_bootstrap(dynamic_memory_begin);
 	sweet_early_mark(13, "pmap_bootstrap done");
 
@@ -2321,6 +2327,13 @@
 	va_l1_end += round_page((vm_size_t)A5_FB_STRIDE * A5_FB_HEIGHT) + (64ULL << 20);
 #endif
 	va_l1_end = (va_l1_end + 0x00000000007FFFFFULL) & 0xFFFFFFFFFF800000ULL;
+#if defined(ARM64_BOARD_CONFIG_A5XELTE)
+	kprintf("A5 avm: l3 va=%#llx end=%#llx fbpg=%#lx segs=%llu n=%llu\n",
+	    (unsigned long long)dynamic_memory_begin, (unsigned long long)va_l1_end,
+	    (unsigned long)round_page(args->Video.v_height * args->Video.v_rowBytes),
+	    (unsigned long long)mem_segments,
+	    (unsigned long long)((va_l1_end - dynamic_memory_begin) / ARM_TT_L2_SIZE));
+#endif
 
 	cpu_l1_tte = cpu_tte + ((va_l1 & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT);
 
