--- a/bsd/dev/jackpotlte_mali.c
+++ b/bsd/dev/jackpotlte_mali.c
@@ -0,0 +1,114 @@
+/*
+ * Galaxy A8 2018 (SM-A530F, jackpotlte, Exynos 7885) Mali GPU probe (M0).
+ *
+ * Probe: map the always-on PMU and CMU_G3D windows, read g3d_pmu_status
+ * (0x11c840a4) and PLL_G3D con0 (0x11400120). If the domain is up, read
+ * the Mali identity and presence registers at 0x11500000. If it is off, skip
+ * the GPU reads. Gated by boot arg jtmaliprobe=1.
+ *
+ * Source addresses: docs/jackpotlte-mali.md sec. 3 (Samsung Eureka tree).
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+void jackpotlte_mali_probe(void);
+
+/* ---- windows ---- */
+#define JT_MALI_PA		0x11500000u
+#define JT_MALI_WINDOW		0x5000u
+#define JT_CMU_G3D_PA		0x11400000u
+#define JT_CMU_G3D_WINDOW	0x8000u
+#define JT_PMU_PA		0x11c80000u
+#define JT_PMU_WINDOW		0x1000u
+
+/* ---- always-on registers (safe to read unconditionally) ---- */
+#define JT_PMU_G3D_STATUS	0x40a4u		/* PMU + 0x40A4, mask 0xF */
+#define JT_PMU_G3D_MASK		0xfu
+#define JT_CMU_PLL_G3D_CON0	0x0120u		/* CMU_G3D + 0x120 */
+
+/* ---- Mali registers (read only if the domain is up) ---- */
+#define JT_MALI_GPU_ID		0x000u
+#define JT_MALI_SHADER_PRESENT	0x100u
+#define JT_MALI_TILER_PRESENT	0x110u
+#define JT_MALI_L2_PRESENT	0x120u
+
+static volatile uint32_t *
+jt_map(uint32_t pa, uint32_t size)
+{
+	return (volatile uint32_t *)ml_io_map(pa, size);
+}
+
+static uint32_t
+jt_rd(volatile uint32_t *base, uint32_t off)
+{
+	if (base == NULL) {
+		return 0;
+	}
+	return base[off >> 2];
+}
+
+void
+jackpotlte_mali_probe(void)
+{
+	int enabled = 0;
+	uint32_t status, pll0, gpu_id;
+	volatile uint32_t *pmu = NULL;
+	volatile uint32_t *cmu = NULL;
+	volatile uint32_t *mali = NULL;
+
+	(void)PE_parse_boot_argn("jtmaliprobe", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+
+	printf("JACKPOTLTE MALI: probe start (jtmaliprobe=1)\n");
+
+	/* The PMU and CMU blocks are always-on: read them first and alone. */
+	pmu = jt_map(JT_PMU_PA, JT_PMU_WINDOW);
+	cmu = jt_map(JT_CMU_G3D_PA, JT_CMU_G3D_WINDOW);
+	if (pmu == NULL || cmu == NULL) {
+		printf("JACKPOTLTE MALI: PMU/CMU map failed\n");
+		return;
+	}
+
+	status = jt_rd(pmu, JT_PMU_G3D_STATUS) & JT_PMU_G3D_MASK;
+	pll0   = jt_rd(cmu, JT_CMU_PLL_G3D_CON0);
+	printf("JACKPOTLTE MALI: g3d_pmu_status=%#x (up=%u) pll_g3d_con0=%#x "
+	    "(enable=%u lock=%u)\n",
+	    status, status == JT_PMU_G3D_MASK,
+	    pll0, (pll0 >> 31) & 1u, (pll0 >> 29) & 1u);
+
+	if (status != JT_PMU_G3D_MASK) {
+		printf("JACKPOTLTE MALI: G3D domain is OFF; GPU registers not read\n");
+		return;
+	}
+
+	mali = jt_map(JT_MALI_PA, JT_MALI_WINDOW);
+	if (mali == NULL) {
+		printf("JACKPOTLTE MALI: GPU map failed\n");
+		return;
+	}
+
+	gpu_id = jt_rd(mali, JT_MALI_GPU_ID);
+	printf("JACKPOTLTE MALI: GPU_ID=%#x (arch=%u) shaders=%#x tiler=%#x l2=%#x\n",
+	    gpu_id, (gpu_id >> 12) & 0xf,
+	    jt_rd(mali, JT_MALI_SHADER_PRESENT),
+	    jt_rd(mali, JT_MALI_TILER_PRESENT),
+	    jt_rd(mali, JT_MALI_L2_PRESENT));
+}
+
+#else   /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
+
+void
+jackpotlte_mali_probe(void)
+{
+}
+
+#endif  /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
