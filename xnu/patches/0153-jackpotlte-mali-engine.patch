+/* ---- M3: the engine a user client drives ----
+ *
+ * The reference's service half (redwood_mali.c:583-1146).  GPU addresses are
+ * handed out from a 32 GB range and never twice, pages are entered into
+ * address space 0, and a job chain is queued and run by a thread of its own,
+ * the submission returning at once with the job's number.  panfrost submits a
+ * pass's chains in order and waits for the number, so the queue runs one job
+ * at a time.
+ */
+#define JT_MALI_JS0			0x1800u	/* fragment chains */
+#define JT_MALI_MMU_INT_RAWSTAT		0x2000u
+#define JT_MALI_MMU_INT_CLEAR		0x2004u
+#define JT_GPU_ADDRESS_FIRST		0x01000000ull
+#define JT_GPU_ADDRESS_END		(1ull << 35)
+
+static LCK_GRP_DECLARE(jt_mali_lock_group, "jackpotlte-mali");
+/* Guards the address space and the tables; an UPDATE takes it.  job_lock is
+ * held for the length of a job, so no table changes under one. */
+static LCK_MTX_DECLARE(jt_mali_lock, &jt_mali_lock_group);
+static LCK_MTX_DECLARE(jt_job_lock, &jt_mali_lock_group);
+
+static volatile uint32_t *jt_gpu;
+static uint32_t jt_gpu_id;
+static uint32_t jt_shader_mask;
+static uint32_t jt_as0_transcfg;
+static bool jt_engine_up;
+static uint64_t jt_next_address = JT_GPU_ADDRESS_FIRST;
+
+/* Completion of a job, without spinning for its whole length: a moment of
+ * polling for the short jobs, then asleep 200 us at a time
+ * (redwood_mali.c:598-624). */
+static int jt_wait_event;
+static LCK_MTX_DECLARE(jt_wait_lock, &jt_mali_lock_group);
+
+static bool
+jt_wait_reg(uint32_t at, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	uint64_t deadline;
+
+	for (int i = 0; i < 20; i++) {
+		if ((jt_rd(jt_gpu, at) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint64_t nap;
+
+		if ((jt_rd(jt_gpu, at) & mask) == want) {
+			return true;
+		}
+		clock_interval_to_deadline(200, NSEC_PER_USEC, &nap);
+		lck_mtx_lock(&jt_wait_lock);
+		(void)lck_mtx_sleep_deadline(&jt_wait_lock, LCK_SLEEP_DEFAULT,
+		    (event_t)&jt_wait_event, THREAD_UNINT, nap);
+		lck_mtx_unlock(&jt_wait_lock);
+	}
+	return (jt_rd(jt_gpu, at) & mask) == want;
+}
+
+bool
+jackpotlte_mali_ready(void)
+{
+	return jt_engine_up;
+}
