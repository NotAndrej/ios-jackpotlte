+/* Linux's DRM_PANFROST_PARAM_*, in its order, from the registers they come
+ * from (redwood_mali.c:763-830).  panfrost asks these once a device exists. */
+bool
+jackpotlte_mali_parameter(uint32_t which, uint64_t *value)
+{
+	static const uint16_t simple[] = {
+		[5] = 0xe00,	/* STACK_PRESENT (none on Bifrost: reads 0) */
+		[6] = 0x018, [7] = 0x01c, [8] = 0x004, [9] = 0x008,
+		[10] = 0x00c, [11] = 0x010, [12] = 0x014, [13] = 0x0ac,
+		[14] = 0x0a0, [15] = 0x0a4, [16] = 0x0a8, [17] = 0x300,
+		[18] = 0x0b0, [19] = 0x0b4, [20] = 0x0b8, [21] = 0x0bc,
+	};
+
+	if (!jt_engine_up) {
+		return false;
+	}
+	switch (which) {
+	case 0:
+		*value = jt_gpu_id >> 16;
+		return true;
+	case 1:
+		*value = jt_gpu_id & 0xffff;
+		return true;
+	case 2:
+	case 3:
+	case 4:
+		*value = jt_rd(jt_gpu, 0x100 + (which - 2) * 0x10) |
+		    ((uint64_t)jt_rd(jt_gpu, 0x104 + (which - 2) * 0x10) << 32);
+		return true;
+	case 38:	/* NR_CORE_GROUPS */
+		*value = 1;
+		return true;
+	case 39:	/* THREAD_TLS_ALLOC: never less than THREAD_MAX_THREADS, or a
+			 * spilling shader writes past the end of its stack
+			 * (redwood_mali.c:800-820). */
+		*value = jt_rd(jt_gpu, 0x310);
+		if (*value < jt_rd(jt_gpu, 0x0a0)) {
+			*value = jt_rd(jt_gpu, 0x0a0);
+		}
+		return true;
+	case 40:	/* AFBC_FEATURES: not on this GPU */
+		*value = 0;
+		return true;
+	default:
+		if (which >= 22 && which <= 37) {
+			*value = jt_rd(jt_gpu, 0x0c0 + (which - 22) * 4);
+			return true;
+		}
+		if (which < sizeof(simple) / sizeof(simple[0]) &&
+		    simple[which] != 0) {
+			*value = jt_rd(jt_gpu, simple[which]);
+			return true;
+		}
+		return false;
+	}
+}
+
+/* `size` bytes of GPU address, never given out twice (redwood_mali.c:835-855).
+ * 0: none left.  64 KB apart, so an overrun faults instead of hitting the
+ * next buffer. */
+uint64_t
+jackpotlte_mali_address(uint64_t size)
+{
+	uint64_t address;
+
+	lck_mtx_lock(&jt_mali_lock);
+	address = jt_next_address;
+	if (address + size > JT_GPU_ADDRESS_END) {
+		address = 0;
+	} else {
+		jt_next_address += (size + 0xffff) & ~0xffffull;
+	}
+	lck_mtx_unlock(&jt_mali_lock);
+	return address;
+}
+
+bool
+jackpotlte_mali_map(uint64_t gpu, uint64_t phys)
+{
+	bool done;
+
+	lck_mtx_lock(&jt_mali_lock);
+	done = jt_map_page(gpu, phys);
+	lck_mtx_unlock(&jt_mali_lock);
+	return done;
+}
+
+void
+jackpotlte_mali_unmap(uint64_t gpu, uint64_t size)
+{
+	if (jt_pt_top == NULL) {
+		return;
+	}
+	lck_mtx_lock(&jt_mali_lock);
+	for (uint64_t at = gpu; at < gpu + size; at += 4096) {
+		jt_unmap_page(at);
+	}
+	lck_mtx_unlock(&jt_mali_lock);
+
+	lck_mtx_lock(&jt_job_lock);	/* an entry taken out: the TLB may hold it */
+	lck_mtx_lock(&jt_mali_lock);
+	jt_as0_update(jt_gpu, jt_pt_top_phys, jt_as0_transcfg);
+	lck_mtx_unlock(&jt_mali_lock);
+	lck_mtx_unlock(&jt_job_lock);
+}
+
+/* After entries are added: the address space is set up from the top again,
+ * which drops everything the MMU remembered of it (redwood_mali.c:697-707). */
+void
+jackpotlte_mali_mapped(void)
+{
+	lck_mtx_lock(&jt_job_lock);
+	lck_mtx_lock(&jt_mali_lock);
+	jt_as0_update(jt_gpu, jt_pt_top_phys, jt_as0_transcfg);
+	lck_mtx_unlock(&jt_mali_lock);
+	lck_mtx_unlock(&jt_job_lock);
+}
+
+/* One job chain from GPU address `chain`, run to its end before this returns:
+ * fragment chains on slot 0, the rest on slot 1.  0 when it finished,
+ * otherwise the slot's status (or 0xff for no answer within a second), and
+ * the GPU is reset so the next job finds it working (redwood_mali.c:900-955).
+ */
+uint32_t
+jackpotlte_mali_submit(uint64_t chain, bool fragment)
+{
+	uint32_t slot = fragment ? 0 : 1;
+	uint32_t js = fragment ? JT_MALI_JS0 : JT_MALI_JS1;
+	uint32_t raw, status = 0;
+	bool finished;
+
+	lck_mtx_lock(&jt_job_lock);
+	lck_mtx_lock(&jt_mali_lock);
+	jt_wr(jt_gpu, JT_MALI_JOB_INT_CLEAR,
+	    (1u << slot) | (1u << (slot + 16)));
+	jt_wr(jt_gpu, js + JT_MALI_JS_HEAD_NEXT_LO, (uint32_t)chain);
+	jt_wr(jt_gpu, js + JT_MALI_JS_HEAD_NEXT_HI, (uint32_t)(chain >> 32));
+	jt_wr(jt_gpu, js + JT_MALI_JS_AFFINITY_NEXT_LO, jt_shader_mask);
+	jt_wr(jt_gpu, js + JT_MALI_JS_AFFINITY_NEXT_HI, 0);
+	jt_wr(jt_gpu, js + JT_MALI_JS_CONFIG_NEXT, JT_MALI_JS_CONFIG);
+	jt_wr(jt_gpu, js + JT_MALI_JS_COMMAND_NEXT, JT_MALI_JS_COMMAND_START);
+	lck_mtx_unlock(&jt_mali_lock);
+
+	finished = jt_wait_reg(JT_MALI_JOB_INT_RAWSTAT,
+	    (1u << slot) | (1u << (slot + 16)), 1u << slot, 1000);
+
+	lck_mtx_lock(&jt_mali_lock);
+	if (!finished) {
+		raw = jt_rd(jt_gpu, JT_MALI_JOB_INT_RAWSTAT);
+		status = (raw & (1u << (slot + 16))) ?
+		    jt_rd(jt_gpu, js + JT_MALI_JS_STATUS) : 0xff;
+		printf("JACKPOTLTE MALI: a job on slot %u did not finish: "
+		    "interrupts=%#x status=%#x mmu=%#x fault=%#x\n",
+		    slot, raw, jt_rd(jt_gpu, js + JT_MALI_JS_STATUS),
+		    jt_rd(jt_gpu, JT_MALI_MMU_INT_RAWSTAT),
+		    jt_rd(jt_gpu, JT_MALI_AS0 + JT_MALI_AS_FAULTSTATUS));
+		jt_wr(jt_gpu, JT_MALI_GPU_INT_CLEAR, 0xffffffffu);
+		jt_wr(jt_gpu, JT_MALI_GPU_CMD, 1u);
+		(void)jt_wait_reg(JT_MALI_GPU_INT_RAWSTAT,
+		    JT_MALI_IRQ_RESET_DONE, JT_MALI_IRQ_RESET_DONE, 100);
+		jt_wr(jt_gpu, JT_MALI_L2_PWRON, jt_rd(jt_gpu, JT_MALI_L2_PRESENT));
+		jt_wr(jt_gpu, JT_MALI_TILER_PWRON,
+		    jt_rd(jt_gpu, JT_MALI_TILER_PRESENT));
+		jt_wr(jt_gpu, JT_MALI_SHADER_PWRON, jt_shader_mask);
+		(void)jt_wait_reg(JT_MALI_SHADER_READY, jt_shader_mask,
+		    jt_shader_mask, 50);
+		jt_as0_update(jt_gpu, jt_pt_top_phys, jt_as0_transcfg);
+		jt_wr(jt_gpu, JT_MALI_MMU_INT_CLEAR, 0xffffffffu);
+	}
+	jt_wr(jt_gpu, JT_MALI_JOB_INT_CLEAR,
+	    (1u << slot) | (1u << (slot + 16)));
+	lck_mtx_unlock(&jt_mali_lock);
+	lck_mtx_unlock(&jt_job_lock);
+	return status;
+}
+
+/* The job queue, run by a thread of its own (redwood_mali.c:957-1080): a
+ * submission returns at once with the job's number, and whoever needs a job
+ * done waits for that number. */
+#define JT_MALI_QUEUE	64
+static struct {
+	uint64_t chain, seq, queued;
+	bool fragment;
+} jt_queue[JT_MALI_QUEUE];
+static unsigned jt_queue_head, jt_queue_count;
+static uint64_t jt_queued_seq, jt_done_seq;
+static bool jt_worker_started;
+static LCK_MTX_DECLARE(jt_queue_lock, &jt_mali_lock_group);
+
+static void
+jt_mali_worker(void *parameter, wait_result_t result)
+{
+	uint64_t chain, seq;
+	bool fragment;
+
+	(void)parameter;
+	(void)result;
+	for (;;) {
+		lck_mtx_lock(&jt_queue_lock);
+		while (jt_queue_count == 0) {
+			lck_mtx_sleep(&jt_queue_lock, LCK_SLEEP_DEFAULT,
+			    (event_t)&jt_queue_count, THREAD_UNINT);
+		}
+		chain = jt_queue[jt_queue_head].chain;
+		seq = jt_queue[jt_queue_head].seq;
+		fragment = jt_queue[jt_queue_head].fragment;
+		lck_mtx_unlock(&jt_queue_lock);
+
+		(void)jackpotlte_mali_submit(chain, fragment);
+
+		lck_mtx_lock(&jt_queue_lock);
+		jt_queue_head = (jt_queue_head + 1) % JT_MALI_QUEUE;
+		jt_queue_count--;
+		jt_done_seq = seq;
+		lck_mtx_unlock(&jt_queue_lock);
+		wakeup((caddr_t)&jt_done_seq);
+		wakeup((caddr_t)&jt_queue_head);
+	}
+}
+
+uint64_t
+jackpotlte_mali_enqueue(uint64_t chain, bool fragment)
+{
+	uint64_t seq;
+	unsigned at;
+
+	lck_mtx_lock(&jt_queue_lock);
+	if (!jt_worker_started) {
+		thread_t thread;
+
+		if (kernel_thread_start(jt_mali_worker, NULL, &thread) ==
+		    KERN_SUCCESS) {
+			thread_set_thread_name(thread, "jackpotlte-mali");
+			thread_deallocate(thread);
+			jt_worker_started = true;
+		}
+	}
+	if (!jt_worker_started) {
+		lck_mtx_unlock(&jt_queue_lock);
+		return 0;
+	}
+	while (jt_queue_count == JT_MALI_QUEUE) {
+		lck_mtx_sleep(&jt_queue_lock, LCK_SLEEP_DEFAULT,
+		    (event_t)&jt_queue_head, THREAD_UNINT);
+	}
+	seq = ++jt_queued_seq;
+	at = (jt_queue_head + jt_queue_count) % JT_MALI_QUEUE;
+	jt_queue[at].chain = chain;
+	jt_queue[at].seq = seq;
+	jt_queue[at].fragment = fragment;
+	jt_queue[at].queued = mach_absolute_time();
+	jt_queue_count++;
+	lck_mtx_unlock(&jt_queue_lock);
+	wakeup((caddr_t)&jt_queue_count);
+	return seq;
+}
+
+/* Wait until job `seq` is done: true when it is; with timeout 0 only a look. */
+bool
+jackpotlte_mali_wait(uint64_t seq, uint64_t timeout_ns)
+{
+	uint64_t deadline;
+	bool done;
+
+	if (timeout_ns > 10ull * NSEC_PER_SEC) {
+		timeout_ns = 10ull * NSEC_PER_SEC;	/* an "infinite" one
+							 * (INT64_MAX) would wrap */
+	}
+	nanoseconds_to_absolutetime(timeout_ns, &deadline);
+	deadline += mach_absolute_time();
+	lck_mtx_lock(&jt_queue_lock);
+	while (jt_done_seq < seq && timeout_ns != 0 &&
+	    mach_absolute_time() < deadline) {
+		lck_mtx_sleep_deadline(&jt_queue_lock, LCK_SLEEP_DEFAULT,
+		    (event_t)&jt_done_seq, THREAD_UNINT, deadline);
+	}
+	done = jt_done_seq >= seq;
+	lck_mtx_unlock(&jt_queue_lock);
+	return done;
+}
+
+/* Leave the GPU up and hand it to the service: address space 0 on the tables,
+ * the allocator at its first address (called once bring-up succeeded). */
+void
+jackpotlte_mali_start(volatile uint32_t *mali)
+{
+	uint32_t mmu_features = jt_rd(mali, JT_MALI_GPU_MMU_FEATURES);
+	uint32_t addr_bits = (mmu_features >> 8) & 0xffu;
+	uint32_t addr_field = (addr_bits && addr_bits < 55u) ?
+	    (55u - addr_bits) : 20u;
+	uint32_t transcfg = JT_MALI_AS_TRANSCFG_AARCH64_4K |
+	    (addr_field << 6) | JT_MALI_AS_TRANSCFG_WALK_WB | (1u << 30);
+
+	jt_gpu = mali;
+	jt_gpu_id = jt_rd(mali, JT_MALI_GPU_ID);
+	jt_shader_mask = jt_rd(mali, JT_MALI_SHADER_PRESENT);
+	jt_as0_transcfg = transcfg;
+	if (jt_pt_top == NULL) {
+		jt_pt_top = jt_pt_page(&jt_pt_top_phys);
+	}
+	if (jt_pt_top == NULL) {
+		printf("JACKPOTLTE MALI: no page for the top table, engine down\n");
+		return;
+	}
+	jt_as0_update(mali, jt_pt_top_phys, transcfg);
+	jt_engine_up = true;
+	printf("JACKPOTLTE MALI: engine up, addresses from %#llx, "
+	    "transcfg=%#x shaders=%#x\n",
+	    (unsigned long long)JT_GPU_ADDRESS_FIRST, transcfg, jt_shader_mask);
+}
