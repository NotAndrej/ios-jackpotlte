--- a/bsd/dev/a5xelte_touch.c
+++ b/bsd/dev/a5xelte_touch.c
@@ -995,9 +995,13 @@
 #define JTTS_READ_PANEL_INFO	0x23u
 #define JTTS_READ_ID		0x52u
 #define JTTS_READ_BOOT_STATUS	0x55u
+#define JTTS_READ_ONE_EVENT	0x60u
+#define JTTS_READ_ALL_EVENT	0x61u
 #define JTTS_READ_FW_VERSION	0xa3u
 #define JTTS_STATUS_BOOT_MODE	0x10u
 #define JTTS_STATUS_APP_MODE	0x20u
+#define JTTS_EVENT_COORDINATE	0x00u
+#define JTTS_EVENT_STATUS	0x01u
 
 static vm_offset_t jt_ts_bus;
 
@@ -1160,6 +1164,183 @@
 }
 
 /*
+ * Mode-0 contact path.  It polls the sec_ts event queue and feeds
+ * SweetHIDTouch, exactly like the native driver's coordinate event.  Every
+ * event read is logged raw and decoded so a dead or half-brought-up
+ * controller can be diagnosed.  It writes nothing to the controller itself
+ * (no SENSE_ON, no TOUCH_FUNCTION, no NVM); the only optional writes are the
+ * touch rail/clock enable in jackpotlte_touch_power_up() (boot-arg
+ * a8touchpwr=1).  The worker starts even if the controller is not yet in
+ * application mode, so the interrupt line can still be watched.
+ */
+static int jt_ts_sleep;
+static vm_offset_t jt_ts_pinctrl0;
+static bool jt_ts_down[5];
+static uint16_t jt_ts_x[5];
+static uint16_t jt_ts_y[5];
+
+static void
+jackpotlte_touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&jt_ts_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Decode one 8-byte sec_ts coordinate event exactly like the native driver
+ * (Eureka drivers/input/touchscreen/sec_ts/sec_ts.c:1099-1105): tid is
+ * 1-based, x = x_11_4 << 4 | x_3_0, y = y_11_4 << 4 | y_3_0, and the action
+ * is tchsta (app/move/release).  The 8-byte bit layout is sec_ts.h:595-609. */
+static void
+jackpotlte_touch_report(const uint8_t *ev)
+{
+	unsigned eid = ev[0] & 0x3u;
+	unsigned tid = (ev[0] >> 2) & 0xfu;
+	unsigned action = (ev[0] >> 6) & 0x3u;
+	unsigned rx;
+	unsigned ry;
+	unsigned x;
+	unsigned y;
+
+	printf("A8 TOUCH: event %02x %02x %02x %02x %02x %02x %02x %02x eid=%u tid=%u act=%u\n",
+	    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7],
+	    eid, tid, action);
+	if (eid != JTTS_EVENT_COORDINATE || tid == 0 || tid > 5) {
+		return;		/* status/other event: already logged raw */
+	}
+	tid -= 1;
+	rx = ((unsigned)ev[1] << 4) | (ev[3] >> 4);
+	ry = ((unsigned)ev[2] << 4) | (ev[3] & 0xfu);
+	/* Raw 12-bit panel coordinates (DTS sec,max_coords = <4096 4096>,
+	 * line 638) into SweetHIDTouch's 1080x1920 A5XELTE space. */
+	x = rx * 1080u / 4096u;
+	y = ry * 1920u / 4096u;
+	if (x > 1079u) {
+		x = 1079u;
+	}
+	if (y > 1919u) {
+		y = 1919u;
+	}
+	printf("A8 TOUCH: %s id=%u raw=(%u,%u) panel=(%u,%u)\n",
+	    action == 1u ? "press" : action == 2u ? "move" : "release",
+	    tid, rx, ry, x, y);
+	if (action == 1u || action == 2u) {		/* press, move */
+		jt_ts_down[tid] = true;
+		jt_ts_x[tid] = (uint16_t)x;
+		jt_ts_y[tid] = (uint16_t)y;
+		sweet_hid_touch((int)tid, 1, (int)x, (int)y);
+	} else if (action == 3u && jt_ts_down[tid]) {	/* release */
+		jt_ts_down[tid] = false;
+		sweet_hid_touch((int)tid, 0, jt_ts_x[tid], jt_ts_y[tid]);
+	}
+}
+
+static void
+jackpotlte_touch_thread(void *arg, wait_result_t result)
+{
+	uint8_t buf[8 * 4];
+	unsigned errors = 0;
+	unsigned idle = 0;
+	int last_irq = -1;
+	(void)arg;
+	(void)result;
+	printf("A8 TOUCH: contact worker started (debug log on)\n");
+	for (;;) {
+		/* IRQ gpa0-0 (DTS line 635) is level low while events queue. */
+		int irq = !!(a5touch_read(jt_ts_pinctrl0,
+		    JTTS_GPA0_OFF + JTTS_PIN_DAT) & 1u);
+		if (irq != last_irq) {
+			printf("A8 TOUCH: irq gpa0-0 -> %s\n",
+			    irq ? "high" : "low");
+			last_irq = irq;
+		}
+		if (irq) {
+			if (++idle == 4000) {	/* ~32 s heartbeat */
+				printf("A8 TOUCH: idle, irq high for %u polls\n",
+				    idle);
+				idle = 0;
+			}
+			jackpotlte_touch_wait(8);
+			continue;
+		}
+		idle = 0;
+		if (!jtts_read_reg(JTTS_READ_ONE_EVENT, buf, 8)) {
+			if (++errors <= 8 || !(errors & 255)) {
+				printf("A8 TOUCH: event read failed (%u) stat=%#x\n",
+				    errors,
+				    a5touch_read(jt_ts_bus, JTTS_IICSTAT));
+			}
+			jackpotlte_touch_wait(20);
+			continue;
+		}
+		printf("A8 TOUCH: read %02x %02x %02x %02x %02x %02x %02x %02x left=%u\n",
+		    buf[0], buf[1], buf[2], buf[3], buf[4], buf[5], buf[6],
+		    buf[7], buf[7] & 0x3fu);
+		unsigned left = buf[7] & 0x3fu;
+		if (buf[0] && left >= 1u && left <= 2u &&
+		    !jtts_read_reg(JTTS_READ_ALL_EVENT, buf + 8, left * 8)) {
+			left = 0;
+		}
+		if (!buf[0]) {
+			jackpotlte_touch_wait(4);	/* empty queue */
+			continue;
+		}
+		for (unsigned i = 0; i <= left; i++) {
+			if (buf[i * 8]) {
+				jackpotlte_touch_report(buf + i * 8);
+			}
+		}
+		errors = 0;
+	}
+}
+
+static void
+jackpotlte_touch_contacts(uint8_t boot)
+{
+	thread_t thread;
+	uint8_t st = 0;
+	uint8_t id[3] = {0};
+	int enabled = 0;
+	int power = 0;
+
+	(void)PE_parse_boot_argn("a8touchlog", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	(void)PE_parse_boot_argn("a8touchpwr", &power, sizeof(power));
+	printf("A8 TOUCH: contact path; status before power=%#x pwr=%d\n",
+	    boot, power);
+	if (power) {
+		jackpotlte_touch_power_up();
+		if (jtts_read_reg(JTTS_READ_BOOT_STATUS, &st, 1)) {
+			boot = st;
+			printf("A8 TOUCH: status after power=%#x (%s)\n", boot,
+			    boot == JTTS_STATUS_APP_MODE ? "app mode" :
+			    boot == JTTS_STATUS_BOOT_MODE ? "boot mode" :
+			    "unknown");
+		} else {
+			printf("A8 TOUCH: status read failed after power\n");
+		}
+		if (jtts_read_reg(JTTS_READ_ID, id, sizeof(id))) {
+			printf("A8 TOUCH: id after power %02x%02x%02x\n",
+			    id[0], id[1], id[2]);
+		}
+	}
+	jt_ts_pinctrl0 = ml_io_map(JTTS_PINCTRL0, 0x1000);
+	if (!jt_ts_pinctrl0) {
+		printf("A8 TOUCH: contact pinctrl mapping failed\n");
+		return;
+	}
+	if (kernel_thread_start(jackpotlte_touch_thread, NULL, &thread) ==
+	    KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A8 TOUCH: contact thread start failed\n");
+	}
+}
+
+/*
  * Optional touch power bring-up, debug only (boot-arg a8touchpwr=1, default
  * off).  S-Boot can leave the touch rail cold: tsp_ldo_en (gpg3-0, DTS
  * "regulator-fixed" 1.8 V, enable-active-high) reads low, so the sec_ts chip
@@ -1273,6 +1454,7 @@
 		printf("A8 TOUCH: fw version %02x%02x%02x%02x\n",
 		    fw[0], fw[1], fw[2], fw[3]);
 	}
+	jackpotlte_touch_contacts(boot);
 }
 #endif /* JACKPOTLTE */
 
