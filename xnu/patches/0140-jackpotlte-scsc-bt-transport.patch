index 0000000..c1b3d20
--- /dev/null
+++ b/bsd/dev/a5xelte_bt.h
@@ -0,0 +1,102 @@
+/*
+ * Galaxy A8 2018 (SM-A530F, jackpotlte, Exynos7885) Samsung SCSC / Maxwell
+ * (MX140) Bluetooth service: hardware/protocol facts (patch 0140).
+ *
+ * Bluetooth is a *second service* on the same Maxwell R4 that the WLAN port
+ * (patch 0138) starts, not a separate chip.  This header carries only values
+ * that are quoted from Samsung's own sources, plus two constants derived by
+ * arithmetic on quoted values (marked DERIVED).
+ *
+ *   MX    = Eureka-Kernel/include/scsc/scsc_mx.h
+ *   PRIV  = Eureka-Kernel/drivers/misc/samsung/scsc_bt/scsc_bt_priv.h
+ *   BTMOD = Eureka-Kernel/drivers/misc/samsung/scsc_bt/scsc_bt_module.c
+ *   SHM   = Eureka-Kernel/drivers/misc/samsung/scsc_bt/scsc_shm.c
+ *   BHCS  = Eureka-Kernel/include/scsc/api/bhcs.h
+ *   BSM   = Eureka-Kernel/include/scsc/api/bsmhcp.h
+ *   FILE  = Eureka-Kernel/drivers/misc/samsung/scsc/mx140_file.c
+ *   SERV  = Eureka-Kernel/drivers/misc/samsung/scsc/scsc_service.c
+ *   SRVMSG= Eureka-Kernel/drivers/misc/samsung/scsc/servman_messages.h
+ *
+ * Status of each item is marked implemented / stubbed / unknown in
+ * docs/research/jackpotlte-bt.md.
+ */
+#ifndef _A5XELTE_BT_H_
+#define _A5XELTE_BT_H_
+
+#include <sys/types.h>
+
+/* ---- service identity -----------------------------------------------------
+ * The BT service id the vendor driver passes to scsc_mx_service_open()
+ * (BTMOD:770-773).  WLAN is 1, ANT is 3 (MX:28-30).
+ */
+#define A5BT_SERVICE_ID                 2u      /* MX:29 */
+
+/* Service-management message sent by scsc_mx_service_start():
+ *   struct sm_msg_packet { service_id, msg, optional_data }   (SRVMSG:28-38)
+ * SM_MSG_START_REQ is the first enumerator, value 0 (SRVMSG:16-19).
+ */
+#define A5BT_SM_MSG_START_REQ           0u      /* SRVMSG:17 */
+
+/* ---- BHCS (Bluetooth Host Configuration Structure) ------------------------
+ * Written by the host, passed to the firmware as the service-start argument
+ * (BHCS:9-16, 33-42).  The structure is 23 bytes; the driver aligns every
+ * MIF allocation to BSMHCP_ALIGNMENT == 32 (BSM:78).
+ *
+ *   struct BHCS {
+ *       uint32_t version;                 // BHCS:34
+ *       uint32_t bsmhcp_protocol_offset;  // BHCS:35
+ *       uint32_t bsmhcp_protocol_length;  // BHCS:36
+ *       uint32_t configuration_offset;    // BHCS:37
+ *       uint32_t configuration_length;    // BHCS:38
+ *       uint32_t bluetooth_address_lap;   // BHCS:39
+ *       uint8_t  bluetooth_address_uap;   // BHCS:40
+ *       uint16_t bluetooth_address_nap;   // BHCS:41
+ *   };
+ */
+#define A5BT_BHCS_VERSION               2u      /* BHCS:31 */
+
+/* ---- BSMHCP_PROTOCOL region ----------------------------------------------
+ * The vendor allocates sizeof(struct BSMHCP_PROTOCOL), zeroes it, writes the
+ * header magic and (separately) the interrupt-source bits and the transfer
+ * ring indices (SHM:1577-1600, 95-128).  The layout is BSM:275-321.
+ *
+ * Both numbers below are DERIVED from quoted values; the arithmetic is shown
+ * so it can be re-checked instead of trusted:
+ *
+ *   offsetof(BSMHCP_PROTOCOL, acl_tx_buffer) = 0x2AA0        (BSM:290)
+ *   sizeof(BSMHCP_PROTOCOL) = 0x165C0
+ *       acl_tx_free_transfer_ring starts at 0x16540          (BSM:319-321)
+ *       x BSMHCP_TRANSFER_RING_ACL_SIZE(32) * sizeof(BSMHCP_TD_ACL_TX_FREE)(4)
+ *       = 0x16540 + 0x80 = 0x165C0
+ *   BSMHCP_PROTOCOL_MAGICVALUE                               (BSM:326-329)
+ *       = (BSMHCP_ACL_BUFFER_SIZE(1024) | BSMHCP_CMD_EVT_BUFFER_SIZE(258) |
+ *          (0x2AA0 << 15)) ^ 0x165C0
+ *       = (0x400 | 0x102 | 0x15550000) ^ 0x165C0
+ *       = 0x15550502 ^ 0x165C0 = 0x155460C2
+ */
+#define A5BT_BSMHCP_ALIGN               32u      /* BSM:78 */
+#define A5BT_BSMHCP_ACL_TX_OFF          0x2AA0u /* BSM:290 */
+#define A5BT_BSMHCP_SIZE                0x165C0u /* DERIVED, see above */
+#define A5BT_BSMHCP_MAGIC               0x155460C2u /* DERIVED, see above */
+
+/* ---- BT configuration table ----------------------------------------------
+ * The vendor asks for
+ *   mx140_file_request_conf(core, &firm, "bluetooth", "bt.hcf")
+ * (BTMOD:578-579) with SCSC_BT_CONF "bt.hcf" (PRIV:51).  mx140_file.c's flat
+ * naming turns that into "<base>/mx140_bt.hcf" (FILE:145-152), which is
+ * exactly the name the local jackpotlte firmware dump carries (116 bytes).
+ * The path below is a port staging choice mirroring A5SCSC_FW_PATH: the
+ * blob lives on the staged iOS root and is never committed to git.
+ */
+#define A5BT_CONF_PATH                  "/private/var/wifi/mx140_bt.hcf"
+#define A5BT_CONF_MAX                   0x1000u
+
+/* ---- host-facing contract (vendor side; NOT implemented here) -------------
+ * SCSC_BT=y exposes HCI H4 on a character device named SCSC_H4_DEVICE_NAME
+ * "scsc_h4_0" (PRIV:57, BTMOD:2079-2094).  SCSC_BT_BLUEZ (default N, not set
+ * in the jackpot defconfig) registers a virtual HCI device with
+ * hci_alloc_dev()/HCI_VIRTUAL/HCI_BREDR (scsc_bluez.c:178-194).
+ */
+#define A5BT_H4_DEVICE_NAME             "scsc_h4_0" /* PRIV:57 */
+
+#endif /* _A5XELTE_BT_H_ */
