diff --git a/bsd/dev/a5xelte_bt.c b/bsd/dev/a5xelte_bt.c
new file mode 100644
index 0000000..8f62520
--- /dev/null
+++ b/bsd/dev/a5xelte_bt.c
@@ -0,0 +1,195 @@
+/*
+ * Galaxy A8 2018 (SM-A530F, jackpotlte, Exynos7885) Samsung SCSC / Maxwell
+ * (MX140) Bluetooth service, step 1 (patch 0140).
+ *
+ * WLAN and Bluetooth are two services on the same Maxwell R4 core, over the
+ * same MX mailbox + MIF transport (include/scsc/scsc_mx.h:27-35).  Patch 0138
+ * brings up that shared transport (PMU rails, mailbox bank, MIF DRAM, smxf
+ * firmware load, MBOX0-3 startup, reset release).  This file adds the
+ * Bluetooth-service half on top of it:
+ *
+ *   - reads the BT configuration table the vendor driver requests
+ *     ("bluetooth/bt.hcf", scsc_bt_module.c:578-579; the local dump carries it
+ *     as mx140_bt.hcf);
+ *   - allocates and fills the BSMHCP_PROTOCOL region (zeroed + magic) and the
+ *     BHCS host configuration structure in MIF DRAM, exactly where the vendor
+ *     does (scsc_shm.c:1577-1600, bhcs.h:33-42);
+ *   - reports the service-start message the vendor would send next.
+ *
+ * What is deliberately NOT done here (marked STUBBED in docs/research/
+ * jackpotlte-bt.md, and logged at runtime):
+ *   - the three MIF interrupt bits (one to-host, two from-host) are allocated
+ *     by the MX core in the vendor tree (scsc_shm.c:95-128); that allocator is
+ *     not ported, so the BSMHCP interrupt-source fields stay zero;
+ *   - the BSMHCP transfer-ring mailbox indices are likewise left zero;
+ *   - the SM_MSG_START_REQ service-start message is not sent: it travels on
+ *     the mxmgmt transport (scsc_service.c:147-168), whose streams 0138 does
+ *     not serialise, and no mailbox ISR is registered, so SM_MSG_START_CFM
+ *     could never be received;
+ *   - the Bluetooth address is left 0: the vendor takes it from the SoC unique
+ *     id (scsc_bt_module.c:628-635) or /csa/bluetooth/.bd_addr (scsc_bt_priv.h:53),
+ *     neither of which exists on XNU yet;
+ *   - there is no HCI character device or virtual HCI device.  The vendor's
+ *     host-facing contract is HCI H4 on /dev/scsc_h4_0 under SCSC_BT, or a
+ *     virtual HCI device under SCSC_BT_BLUEZ (scsc_bluez.c:178-194).
+ *
+ * Safety: everything here is behind the "a8bt" boot argument, which is off by
+ * default.  It reuses the 0138 transport, which is itself unproven on this
+ * phone; nothing writes a partition and nothing touches bootloaders, EFS or
+ * recovery.  The "a8wifi" gate is untouched.
+ *
+ * The first thing to look for on hardware is the ordered pair of lines
+ *   A5XELTE SCSC: WLBT released from reset; transport up ...
+ *   A5XELTE BT: service id 2 descriptor ...
+ * If the first never appears the shared transport is the problem, not BT; if
+ * the second appears but the config line above it reports a read error, the
+ * blob is not staged at A5BT_CONF_PATH.
+ */
+#if defined(ARM64_BOARD_CONFIG_A5XELTE) && defined(JACKPOTLTE)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+#include "a5xelte_scsc.h"
+#include "a5xelte_bt.h"
+
+void a5xelte_bt_probe(void);
+
+/* struct BHCS, bhcs.h:33-42.  23 bytes; the firmware reads it through the
+ * reference handed to the service-start callback (bhcs.h:9-16). */
+struct a5bt_bhcs {
+	uint32_t version;                /* bhcs.h:34 */
+	uint32_t bsmhcp_protocol_offset; /* bhcs.h:35 */
+	uint32_t bsmhcp_protocol_length; /* bhcs.h:36 */
+	uint32_t configuration_offset;   /* bhcs.h:37 */
+	uint32_t configuration_length;   /* bhcs.h:38 */
+	uint32_t bluetooth_address_lap;  /* bhcs.h:39 */
+	uint8_t  bluetooth_address_uap;  /* bhcs.h:40 */
+	uint16_t bluetooth_address_nap;  /* bhcs.h:41 */
+} __attribute__((packed));
+
+/* One attempt at the BT-service descriptor.  Returns 0 when the shared
+ * transport is up and the descriptor is placed; EAGAIN when the transport is
+ * not up yet (root not mounted / another bring-up in progress). */
+static int
+a5bt_setup(void)
+{
+	struct a5bt_bhcs *bhcs;
+	uint32_t bhcs_ref = 0, bsmhcp_ref = 0, conf_ref = 0;
+	void *bsmhcp;
+	size_t conf_size = 0;
+	int err;
+
+	if (!a5scsc_transport_up()) {
+		return EAGAIN;
+	}
+
+	/* BSMHCP_PROTOCOL: zeroed, header magic written.  Same two operations
+	 * the vendor performs (scsc_shm.c:1583-1585), minus the interrupt-bit
+	 * and mailbox-index setup it does at 1586-1600 / 95-128 (STUBBED). */
+	if (!a5scsc_mifram_alloc(A5BT_BSMHCP_SIZE, A5BT_BSMHCP_ALIGN, &bsmhcp_ref)) {
+		printf("A5XELTE BT: BSMHCP allocation failed (%u bytes)\n", A5BT_BSMHCP_SIZE);
+		return ENOMEM;
+	}
+	bsmhcp = a5scsc_mifram_ptr(bsmhcp_ref);
+	bzero(bsmhcp, A5BT_BSMHCP_SIZE);
+	*(volatile uint32_t *)bsmhcp = A5BT_BSMHCP_MAGIC;
+
+	/* BHCS (bhcs.h:33-42).  Fields the host owns are filled here. */
+	if (!a5scsc_mifram_alloc(sizeof(struct a5bt_bhcs), A5BT_BSMHCP_ALIGN, &bhcs_ref)) {
+		printf("A5XELTE BT: BHCS allocation failed\n");
+		return ENOMEM;
+	}
+	bhcs = a5scsc_mifram_ptr(bhcs_ref);
+	bzero(bhcs, sizeof(*bhcs));
+	bhcs->version = A5BT_BHCS_VERSION;                    /* bhcs.h:31 */
+	bhcs->bsmhcp_protocol_offset = bsmhcp_ref;            /* bhcs.h:35 */
+	bhcs->bsmhcp_protocol_length = A5BT_BSMHCP_SIZE;      /* bhcs.h:36 */
+	bhcs->configuration_offset = 0;                       /* bhcs.h:37 */
+	bhcs->configuration_length = 0;                       /* bhcs.h:38 */
+	bhcs->bluetooth_address_lap = 0;                      /* bhcs.h:39 */
+	bhcs->bluetooth_address_uap = 0;                      /* bhcs.h:40 */
+	bhcs->bluetooth_address_nap = 0;                      /* bhcs.h:41 */
+
+	/* BT configuration table.  A missing file is not fatal in the vendor
+	 * driver (scsc_bt_module.c:580-583); it just leaves the config empty. */
+	if (a5scsc_mifram_alloc(A5BT_CONF_MAX, 64, &conf_ref)) {
+		err = a5scsc_read_file(A5BT_CONF_PATH, a5scsc_mifram_ptr(conf_ref),
+		    A5BT_CONF_MAX, &conf_size);
+		if (err != 0) {
+			printf("A5XELTE BT: config %s not readable (%d); config empty\n",
+			    A5BT_CONF_PATH, err);
+			conf_size = 0;
+		} else {
+			bhcs->configuration_offset = conf_ref;
+			bhcs->configuration_length = (uint32_t)conf_size;
+			printf("A5XELTE BT: config %s %u bytes at MIF 0x%x\n",
+			    A5BT_CONF_PATH, (unsigned)conf_size, conf_ref);
+		}
+	} else {
+		printf("A5XELTE BT: config region allocation failed\n");
+	}
+
+	printf("A5XELTE BT: service id %u descriptor bhcs=0x%x bsmhcp=0x%x len=0x%x ver=%u\n",
+	    A5BT_SERVICE_ID, bhcs_ref, bsmhcp_ref, A5BT_BSMHCP_SIZE, A5BT_BHCS_VERSION);
+
+	/* Next vendor step, not performed: scsc_mx_service_start() sends
+	 * sm_msg_packet{service_id, SM_MSG_START_REQ, bhcs_ref} on
+	 * MMTRANS_CHAN_ID_SERVICE_MANAGEMENT and waits for SM_MSG_START_CFM
+	 * (scsc_service.c:147-168; servman_messages.h:15-38).  STUBBED. */
+	printf("A5XELTE BT: STUB service-start id=%u msg=%u ref=0x%x; hci dev %s not created\n",
+	    A5BT_SERVICE_ID, A5BT_SM_MSG_START_REQ, bhcs_ref, A5BT_H4_DEVICE_NAME);
+	return 0;
+}
+
+static void
+a5bt_bringup_thread(void *param __unused, wait_result_t wr __unused)
+{
+	int attempt;
+
+	/* The staged iOS root (firmware/config) may not be mounted yet. */
+	for (attempt = 0; attempt < 60; attempt++) {
+		if (a5bt_setup() == 0) {
+			printf("A5XELTE BT: BT service descriptor ready (transport unproven)\n");
+			return;
+		}
+		delay(500000);  /* 500 ms */
+	}
+	printf("A5XELTE BT: bring-up did not complete\n");
+}
+
+/* ---- public entry point --------------------------------------------------- */
+
+void
+a5xelte_bt_probe(void)
+{
+	int enabled = 0;
+	thread_t thread = THREAD_NULL;
+
+	/* Separate, default-off gate: "a8bt" never enables anything on its own
+	 * and does not read or change the WLAN "a8wifi" gate. */
+	(void)PE_parse_boot_argn("a8bt", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A5XELTE BT: probe only (a8bt=0); BT service not started\n");
+		return;
+	}
+
+	if (kernel_thread_start((thread_continue_t)a5bt_bringup_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A5XELTE BT: bring-up thread failed to start\n");
+	}
+}
+
+#else   /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
+
+void
+a5xelte_bt_probe(void)
+{
+}
+
+#endif  /* ARM64_BOARD_CONFIG_A5XELTE && JACKPOTLTE */
