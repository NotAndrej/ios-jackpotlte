 #include "sw/null/null_sw_winsys.h"
 
+#include "frontend/winsys_handle.h"
+#include "pipe/p_screen.h"
+#include "pipe/p_state.h"
+
+#ifdef __APPLE__
+#include "panfrost/drm/panfrost_drm_public.h"
+#include "util/driconf.h"
+#include "util/macros.h"
+#include "util/u_debug.h"
+#include <xf86drm.h>
+
+static int gpu_fd = -1;
+
+static const driOptionDescription panfrost_options[] = {
+#include "panfrost/driinfo_panfrost.h"
+};
+
+/*
+ * The Mali's driver, where the kernel has the Mali up for programs (this port:
+ * the JackpotlteMali user client, 0154); NULL: none, and the processor draws as
+ * before.
+ */
+static struct pipe_screen *
+osmesa_create_gpu_screen(void)
+{
+   static driOptionCache info, cache;
+   static struct pipe_screen_config config;
+   struct pipe_screen *screen;
+   int fd;
+
+   if (debug_get_bool_option("OSMESA_SOFTWARE", false))
+      return NULL;
+   fd = drmOpenWithType("panfrost", NULL, DRM_NODE_RENDER);
+   if (fd < 0)
+      return NULL;
+   driParseOptionInfo(&info, panfrost_options, ARRAY_SIZE(panfrost_options));
+   config.options = &cache;
+   config.options_info = &info;
+   screen = panfrost_drm_screen_create(fd, &config);
+   if (screen)
+      gpu_fd = fd;
+   return screen ? debug_screen_wrap(screen) : NULL;
+}
+#endif
+
 
 struct pipe_screen *
 osmesa_create_screen(void);
+
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface);
+
+/*
+ * The pixels of a SweetSurface as a texture, to draw into and to draw with: the
+ * kernel's GPU driver makes a buffer of the surface (0154's 0x7e).  NULL: the
+ * screen is not the GPU's, or the surface is not one plane of 32-bit pixels,
+ * blue first, in rows the GPU can address.
+ */
+struct pipe_resource *
+osmesa_surface_resource(struct pipe_screen *screen, uint32_t surface)
+{
+#ifdef __APPLE__
+   struct jackpotlte_drm_surface s = { .surface = surface };
+   struct pipe_resource templ = {
+      .target = PIPE_TEXTURE_2D,
+      .format = PIPE_FORMAT_B8G8R8A8_UNORM,
+      .depth0 = 1,
+      .array_size = 1,
+      .bind = PIPE_BIND_SAMPLER_VIEW | PIPE_BIND_RENDER_TARGET,
+   };
+   struct winsys_handle handle = { .type = WINSYS_HANDLE_TYPE_FD };
+
+   if (gpu_fd < 0 || jackpotlte_drm_surface(gpu_fd, &s) != 0)
+      return NULL;
+   if (s.pixel_format != 0x42475241 /* 'BGRA' */ || s.planes != 0)
+      return NULL;
+   templ.width0 = s.width;
+   templ.height0 = s.height;
+   handle.handle = surface;
+   handle.stride = s.row_bytes;
+   handle.offset = s.offset;
+   handle.size = s.size;
+   return screen->resource_from_handle(screen, &templ, &handle, 0);
+#else
+   (void)screen;
+   (void)surface;
+   return NULL;
+#endif
+}
 
 
