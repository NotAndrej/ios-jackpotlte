--- a/src/panfrost/lib/kmod/meson.build
+++ b/src/panfrost/lib/kmod/meson.build
@@ -7,11 +7,22 @@
   'panthor_kmod.c',
 )
 
+# Darwin: the stand-in for libdrm (src/jackpotlte-drm, put there by
+# tools/mesa-jackpotlte/mk-mesa-jackpotlte.sh); its sources are built here,
+# beside the panfrost requests that carry them to our kernel's user client.
+pankmod_darwin_args = []
+if host_machine.system() == 'darwin'
+  libpankmod_lib_files += files('../../../jackpotlte-drm/jackpotlte_drm.c',
+                                '../../../jackpotlte-drm/jackpotlte_gpu.c',
+                                '../../../jackpotlte-drm/jackpotlte_iokit.c')
+  pankmod_darwin_args += ['-DJACKPOTLTE_DRM_IOS=1']
+endif
+
 libpankmod_lib = static_library(
   'pankmod_lib',
   [libpankmod_lib_files],
   include_directories : [inc_include, inc_src, inc_panfrost],
-  c_args : [no_override_init_args],
+  c_args : [no_override_init_args, pankmod_darwin_args],
   gnu_symbol_visibility : 'hidden',
   dependencies: [dep_libdrm, idep_mesautil, idep_pan_packers],
   build_by_default : false,
