-if dep_libdrm.found()
+if host_machine.system() == 'darwin' and with_gallium_panfrost
+  # No DRM on this system: panfrost's requests go to the kernel's GPU driver
+  # through the stand-in in src/jackpotlte-drm, put there by this port's
